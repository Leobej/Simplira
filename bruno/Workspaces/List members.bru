meta {
  name: List members
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/members
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.data[0].role: eq ADMIN
}

docs {
  Members carry the workspace role, which is per workspace - the same account can be ADMIN here
  and DEVELOPER elsewhere. Roles are never in the JWT; they are read from the database per request.

  A new workspace has exactly one member until someone accepts an invitation.
}
