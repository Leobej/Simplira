meta {
  name: Filter issues by label
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/issues?labelId={{labelId}}
  body: none
  auth: inherit
}

params:query {
  labelId: {{labelId}}
}

assert {
  res.status: eq 200
}

docs {
  Repeat labelId to narrow further: ?labelId=A&labelId=B returns only issues wearing both.
  It combines with every other filter in Issues/List backlog.
}
