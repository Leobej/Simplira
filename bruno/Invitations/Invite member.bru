meta {
  name: Invite member
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/invitations
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{inviteEmail}}",
    "role": "DEVELOPER"
  }
}

vars:post-response {
  invitationId: res.body.data.id
}

assert {
  res.status: eq 201
  res.body.data.status: eq PENDING
}

docs {
  Run Workspaces/Create workspace first - it captures workspaceId. ADMIN only.

  The response never contains the token. Only its hash is stored, so the single usable copy is
  the one that was emailed - and email is currently a stub that writes the link to the
  application log:

      [stub email] invitation to=... link=http://localhost:5173/invitations/accept?token=XYZ

  Copy that token into the invitationToken environment variable to run Accept invitation.

  Inviting the same address twice conflicts with 409 INVITATION_ALREADY_SENT; inviting someone
  who already joined conflicts with 409 ALREADY_A_MEMBER.
}
