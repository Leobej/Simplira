meta {
  name: List invitations
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/invitations
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

docs {
  ADMIN only. Shows PENDING, ACCEPTED and EXPIRED invitations, newest first, and never the token.
}
