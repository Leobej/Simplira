meta {
  name: Update profile
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/users/me
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "fullName": "John Example"
  }
}

assert {
  res.status: eq 200
  res.body.data.fullName: eq John Example
}

docs {
  Only the name. Mentions keep working after a rename: they carry the user id, and the name in
  them is display text only.
}
