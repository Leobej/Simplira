meta {
  name: Change password
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/users/me/password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "{{userPassword}}",
    "newPassword": "{{userPassword}}"
  }
}

vars:post-response {
  accessToken: res.body.data.accessToken
}

assert {
  res.status: eq 200
}

docs {
  "Changes" it to the same value so the collection keeps working; set a new one in the body and
  update userPassword to match to try it for real.

  Every other session ends and this one starts again: the response is a login's, with a new access
  token (captured here) and a new refresh cookie. A wrong currentPassword is 400
  INVALID_CURRENT_PASSWORD.
}
