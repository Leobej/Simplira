meta {
  name: Create sprint
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/sprints
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Sprint 1",
    "startDate": "2026-03-02",
    "endDate": "2026-03-16"
  }
}

vars:post-response {
  sprintId: res.body.data.id
}

assert {
  res.status: eq 201
  res.body.data.status: eq PLANNED
}

docs {
  Run Projects/Create project first - it captures projectId. Needs workspace ADMIN or TEAM_LEADER
  on the project.

  Sprints start PLANNED. Dates are advisory: no duration is enforced, and a running sprint can be
  rescheduled without ending it. An end date before the start date is rejected.
}
