meta {
  name: Close sprint
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/sprints/{{sprintId}}/close
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "incompleteIssueAction": "MOVE_TO_BACKLOG"
  }
}

assert {
  res.status: eq 200
  res.body.data.status: eq COMPLETED
}

docs {
  ACTIVE to COMPLETED, and only from ACTIVE.

  incompleteIssueAction is MOVE_TO_BACKLOG or MOVE_TO_SPRINT; the second requires targetSprintId,
  which must belong to the same project and must not already be COMPLETED.

  Unfinished issues are actually moved now. Which ones count as unfinished comes from the status
  category, not its name, so a column called "Shipped" in the DONE category stays put - and
  finished issues keep their sprint, so the sprint keeps its history.
}
