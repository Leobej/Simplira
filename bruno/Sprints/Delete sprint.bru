meta {
  name: Delete sprint
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/api/v1/sprints/{{sprintId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

docs {
  Hard delete - a sprint keeps no history of its own. An ACTIVE sprint is somebody's current
  board, so it is 409 until closed.
}
