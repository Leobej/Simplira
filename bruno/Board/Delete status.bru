meta {
  name: Delete status
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/statuses/{{statusId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

docs {
  Soft delete, which also frees the name and position for reuse.

  Refused when it is the last status in its category, or when it is the default new issues land
  on - hand the default to another status first.

  A status still holding issues is refused with 409 STATUS_HAS_ISSUES. Add ?migrateToStatusId=<id>
  to move them somewhere first - the delete and the migration happen together.
}
