meta {
  name: List statuses
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/statuses
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.data[0].category: eq TODO
}

docs {
  Seeded as To Do, In Progress and Done, ordered by board position.

  Every status carries a category of TODO, IN_PROGRESS or DONE. The name is the team's - rename
  "In Progress" to "In QA" and nothing breaks, because charts, sprint close and blocked detection
  all read the category instead.
}
