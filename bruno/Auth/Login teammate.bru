meta {
  name: Login teammate
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{inviteEmail}}",
    "password": "{{teammatePassword}}"
  }
}

vars:post-response {
  teammateToken: res.body.data.accessToken
  memberUserId: res.body.data.user.id
}

assert {
  res.status: eq 200
}

docs {
  Captures teammateToken, which the few requests that act as the teammate use explicitly, and
  memberUserId, which Assignees, Comments and Projects use to point at them. The collection's
  own bearer auth stays on your accessToken.
}
