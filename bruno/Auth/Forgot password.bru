meta {
  name: Forgot password
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/auth/forgot-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{userEmail}}"
  }
}

assert {
  res.status: eq 200
}

docs {
  Always 200 with no data, for any address - it cannot be used to find out who has an account.

  The stub writes the link to the application log:

      [stub email] password reset to=john@example.com link=http://localhost:5173/reset-password?token=XYZ

  Paste the token into resetToken for Reset password. A second request within 60 seconds sends
  nothing (the per-address cooldown); after that, a new link replaces the old one. Links last an hour.
}
