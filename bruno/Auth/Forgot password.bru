meta {
  name: Forgot password
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/auth/forgot-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{userEmail}}"
  }
}

assert {
  res.status: eq 200
}

docs {
  Always 200 with no data, for any address - it cannot be used to find out who has an account.

  The email lands in Mailpit (http://localhost:8025). Its link ends in ?token=XYZ - copy that
  token into resetToken for Reset password. A second request within 60 seconds sends
  nothing (the per-address cooldown); after that, a new link replaces the old one. Links last an hour.
}
