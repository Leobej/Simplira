meta {
  name: Reset password
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{resetToken}}",
    "newPassword": "{{userPassword}}"
  }
}

assert {
  res.status: eq 204
}

docs {
  Sets the password back to userPassword so the rest of the collection keeps working - change the
  body to try a different one, then update userPassword to match.

  Ends every session: run Login again afterwards (Refresh will be 401). Following the link also
  verifies the email address, since it was sent there. Single use: a second run is 400
  INVALID_RESET_TOKEN.
}
