meta {
  name: Create blocker issue
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/issues
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Provision the staging database"
  }
}

vars:post-response {
  blockerIssueId: res.body.data.id
}

assert {
  res.status: eq 201
}

docs {
  A second issue to link to Issues/Create issue's one. A fresh blocker each run means the folder
  never trips over the one-link-per-pair rule.
}
