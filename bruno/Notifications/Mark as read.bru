meta {
  name: Mark as read
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/notifications/{{notificationId}}/read
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.data.read: eq true
}

docs {
  Uses notificationId from List notifications. Idempotent: reading it again keeps the first
  readAt. Someone else's notification is 404 NOTIFICATION_NOT_FOUND.
}
