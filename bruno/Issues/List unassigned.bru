meta {
  name: List unassigned
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/issues?unassigned=true
  body: none
  auth: inherit
}

params:query {
  unassigned: true
}

assert {
  res.status: eq 200
}

docs {
  Same list endpoint as the backlog, one more filter (§34). Swap unassigned=true for
  assigneeId={{memberUserId}} to get one person's work instead.

  unassigned reads both ways, like isBlocked: true is "nobody owns this", false is "somebody does".
}
