meta {
  name: Create issue
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/issues
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Login button is misaligned",
    "description": "Off by a few pixels on mobile.",
    "priority": "HIGH"
  }
}

vars:post-response {
  issueId: res.body.data.id
}

assert {
  res.status: eq 201
  res.body.data.number: eq 1
}

docs {
  Anyone who can see the project. Run Projects/Create project first - it captures projectId.

  typeId and statusId are optional: leave them out and the project's defaults are used (Task and
  To Do). Send them to pick from List issue types / List statuses.

  The response carries an identifier like SB-1, assembled from the project key and the issue
  number. It is never stored - both halves already exist as columns.

  The number assert only matches on the first issue in a fresh project.
}
